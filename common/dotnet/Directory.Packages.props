<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- OPC Foundation UA-.NETStandard release from nuget.org; locks/ pins content hashes. -->
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="2.0.1" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="2.0.1" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="2.0.1" />
  </ItemGroup>
</Project>
